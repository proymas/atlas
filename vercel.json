{
  "version": 2,
  "functions": {
    "api/analyze-safe-v3.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/analyze",
      "dest": "/api/analyze-safe-v3.js"
    },
    {
      "src": "/api/feedback",
      "dest": "/api/feedback.js"
    },
    {
      "src": "/api/event",
      "dest": "/api/event.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
